[
  {
    "id": "N1-symlink-empty",
    "rule": "not_a_symlink",
    "expect": true,
    "why": "an empty symlink_target means the file is not a link",
    "input": {
      "symlink_target": ""
    }
  },
  {
    "id": "N2-symlink-set",
    "rule": "not_a_symlink",
    "expect": false,
    "why": "a populated symlink_target must be refused",
    "input": {
      "symlink_target": "/etc/passwd"
    }
  },
  {
    "id": "N3-symlink-null",
    "rule": "not_a_symlink",
    "expect": true,
    "why": "the runtime sends null when the field is absent",
    "input": {
      "symlink_target": null
    }
  },
  {
    "id": "S1-sandbox-legitimate",
    "rule": "sandbox_storages_safe",
    "expect": true,
    "why": "the infrastructure rootfs and the shared-memory mount are the only sandbox storages",
    "input": {
      "storages": [
        {
          "driver": "image_guest_pull",
          "fstype": "overlay",
          "source": "pause",
          "mount_point": "/run/kata-containers/c0ffee01/rootfs",
          "driver_options": [
            "image_guest_pull={\"metadata\":{\"io.kubernetes.cri.podsandbox.image-name\":\"ops-console.paas.rafay.dev/pause:3.10.2\"}}"
          ],
          "shared": false,
          "fs_group": null,
          "options": []
        },
        {
          "driver": "ephemeral",
          "fstype": "tmpfs",
          "source": "shm",
          "mount_point": "/run/kata-containers/sandbox/shm",
          "driver_options": [],
          "shared": false,
          "fs_group": null,
          "options": [
            "noexec",
            "nosuid",
            "nodev",
            "mode=1777",
            "size=67108864"
          ]
        }
      ]
    }
  },
